# Copy this file to .env and fill in your key. NEVER commit .env to GitHub.
GOOGLE_API_KEY=your_google_api_key_here
# Model name is configurable. Check your provider's current model list if you get a "model not found" error.
LLM_MODEL=gemini-3-flash-preview
# Retrieval strictness: lower = stricter. Tune this using your evaluation results.
MAX_DISTANCE=0.65